{
  "manifest_version": 3,
  "name": "Review Lens",
  "version": "1.3.3",
  "description": "Turn the reviews and comments on any page into clear themes, a verdict and verified quotes. Compare pages side by side.",
  "homepage_url": "https://github.com/Deep0976/review-lens",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Analyze reviews on this page (Alt+Shift+R)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ]
}
